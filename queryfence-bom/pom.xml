<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.steelreed</groupId>
    <artifactId>queryfence-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>queryfence-bom</artifactId>
  <packaging>pom</packaging>
  <name>QueryFence BOM</name>
  <description>Bill of materials to align versions of all QueryFence modules.</description>
  <url>https://github.com/steelreed/queryfence</url>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.steelreed</groupId>
        <artifactId>queryfence-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.steelreed</groupId>
        <artifactId>queryfence-jdbc</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.steelreed</groupId>
        <artifactId>queryfence-report</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.steelreed</groupId>
        <artifactId>queryfence-junit5</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.steelreed</groupId>
        <artifactId>queryfence-spring-test</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- The published BOM must manage QueryFence artifacts only. Without flattening it would
           inherit queryfence-parent's dependencyManagement and pin Spring, JUnit, JDBC drivers and
           Testcontainers in every build that imports it. bom mode drops the parent and keeps the
           dependencyManagement exactly as declared here. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten-plugin.version}</version>
        <configuration>
          <flattenMode>bom</flattenMode>
          <updatePomFile>true</updatePomFile>
          <outputDirectory>${project.build.directory}</outputDirectory>
          <pomElements>
            <properties>remove</properties>
            <repositories>remove</repositories>
          </pomElements>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <goals>
              <goal>flatten</goal>
            </goals>
            <phase>process-resources</phase>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <goals>
              <goal>clean</goal>
            </goals>
            <phase>clean</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
